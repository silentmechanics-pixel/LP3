   "source": [
    "n = int(input(\"Enter No of terms: \"))\n",
    "\n",
    "first = 0\n",
    "second = 1\n",
    "\n",
    "count = 0\n",
    "\n",
    "for i in range(n):\n",
    "    print(first, end=\" \")\n",
    "\n",
    "    third = first + second\n",
    "    first = second\n",
    "    second = third\n",
    "\n",
    "    count += 1\n",
    "\n",
    "print(\"Count = \", count)"
   ]
